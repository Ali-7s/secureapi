### =====================================================================
### KEY_IDOR — 11 attempts to revoke a key you don't own.
### Each rejected attempt publishes AUTHZ_IDOR from AuthzService.
###
### /api/keys is cookie-authenticated and NOT CSRF-exempt, so the DELETEs
### must echo the XSRF-TOKEN cookie back as a header. That token was
### captured by the SETUP request at the top of this file — see the CSRF
### note in the header if this section 403s.
### =====================================================================

### 1. login as VICTIM
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "victim@test.local",
  "password": "{{goodPassword}}"
}

> {%
    // Refresh only if this response carried a token. Spring stays silent on
    // login, so the guard preserves the value captured at the top of the file.
    const c = response.headers.valuesOf("Set-Cookie").find(h => /^XSRF-TOKEN=[^;]+/.test(h));
    if (c) client.global.set("xsrf", c.split(";")[0].split("=")[1]);

    client.test("victim logged in", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}

### 2. victim creates a key — capture its id as the IDOR target
POST {{host}}/api/keys
Content-Type: application/json
X-XSRF-TOKEN: {{xsrf}}

{
  "label": "victim-key",
  "scopes": "ALERTS_READ"
}

> {%
    // THIS is where the token rotates — an authenticated state-changing
    // request. Miss this capture and every DELETE below dies on CSRF.
    const c = response.headers.valuesOf("Set-Cookie").find(h => /^XSRF-TOKEN=[^;]+/.test(h));
    if (c) client.global.set("xsrf", c.split(";")[0].split("=")[1]);

    client.test("key created", function () {
        client.assert(response.status === 201,
            "Expected 201, got " + response.status +
            ". A 403 here means the CSRF token is missing or stale — clear the " +
            "HTTP Client cookies and re-run this file from the top.");
    });

    // Stored as a string: an unresolved {{victimKeyId}} would silently turn the
    // DELETEs below into requests against a key that never existed.
    if (response.status === 201) {
        client.global.set("victimKeyId", String(response.body.data.apiKeyDTO.id));
        client.log("victim key id = " + client.global.get("victimKeyId"));
    }
%}

### 3. login as ATTACKER (replaces the session cookies)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "attacker@test.local",
  "password": "{{goodPassword}}"
}

> {%
    const c = response.headers.valuesOf("Set-Cookie").find(h => /^XSRF-TOKEN=[^;]+/.test(h));
    if (c) client.global.set("xsrf", c.split(";")[0].split("=")[1]);

    client.test("attacker logged in", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("IDOR target known", function () {
        client.assert(!!client.global.get("victimKeyId"),
            "No victimKeyId — request 2 did not return a key, so the DELETEs below would probe nothing.");
    });
%}

### 4-14. attacker probes the victim's key 11 times — each should be 403 + AUTHZ_IDOR
### Every probe rotates the token again, so each handler feeds the next request.
DELETE {{host}}/api/keys/{{victimKeyId}}
X-XSRF-TOKEN: {{xsrf}}

> {%
    const c = response.headers.valuesOf("Set-Cookie").find(h => /^XSRF-TOKEN=[^;]+/.test(h));
    if (c) client.global.set("xsrf", c.split(";")[0].split("=")[1]);

    client.test("IDOR rejected with 403", function () {
        client.assert(response.status === 403,
            "Expected 403 (AUTHZ_IDOR), got " + response.status +
            ". A 404 means victimKeyId is wrong; a 401 means the attacker is not logged in.");
    });
%}

###
