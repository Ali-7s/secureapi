X-XSRF-TOKEN: {{xsrf}}

> {%
    const c = response.headers.valuesOf("Set-Cookie").find(h => /^XSRF-TOKEN=[^;]+/.test(h));
    if (c) client.global.set("xsrf", c.split(";")[0].split("=")[1]);
%}

